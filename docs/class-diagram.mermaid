classDiagram
direction TB

%% ===================== USUARIOS =====================
class Usuario {
    <<abstract>>
    #String id
    #String nombre
    #String apellido
    #String email
    #String passwordHash
    +validarCredenciales(password) boolean
    +cambiarPassword(actual, nueva) void
}
class Cliente {
    -PreferenciasNotificacion preferencias
    +verHistorialPedidos() List~Pedido~
}
class Administrador {
    +avanzarEstadoPedido(pedido) void
    +gestionarCatalogo() void
}
Usuario <|-- Cliente
Usuario <|-- Administrador

%% ===================== CATALOGO (Composite) =====================
%% Componente: define solo la operacion comun (polimorfica)
class ComponenteCatalogo {
    <<abstract>>
    #String id
    #String nombre
    #boolean activo
    +obtenerProductos() List~Producto~
}
%% Compuesto: contiene la coleccion y define agregar/quitar
class Categoria {
    -List~ComponenteCatalogo~ hijos
    +obtenerProductos() List~Producto~
    +agregar(c ComponenteCatalogo) void
    +quitar(c ComponenteCatalogo) void
}
%% Hoja: elemento simple, no delega ni gestiona hijos
class Producto {
    <<leaf>>
    -String descripcion
    -double precio
    -String material
    -String marca
    -List~String~ imagenes
    +obtenerProductos() List~Producto~
    +hayStock() boolean
}
class Variante {
    -Talla talla
    -String color
    -int stock
    +descontar(cantidad) void
}
class Talla {
    <<enumeration>>
    XS
    S
    M
    L
    XL
    XXL
}
ComponenteCatalogo <|-- Categoria
ComponenteCatalogo <|-- Producto
Categoria o-- "0..*" ComponenteCatalogo : hijos
Producto "1" *-- "1..*" Variante : variantes
Variante --> Talla

%% ===================== CARRITO =====================
class Carrito {
    -List~ItemCarrito~ items
    +agregarItem(variante, cantidad) void
    +modificarCantidad(item, cantidad) void
    +eliminarItem(item) void
    +vaciar() void
    +calcularTotal() double
}
class ItemCarrito {
    -int cantidad
    +subtotal() double
}
Cliente "1" --> "1" Carrito : posee
Carrito "1" *-- "0..*" ItemCarrito
ItemCarrito --> Variante

%% ===================== PEDIDOS (State) + Contexto Strategy/Observer =====================
class Pedido {
    -LocalDateTime fecha
    -double total
    -List~ItemPedido~ items
    -List~TransicionEstado~ historialEstados
    -DireccionEnvio direccionEnvio
    -EstadoPedido estado
    -MetodoPago metodoPago
    -List~CanalNotificacion~ observadores
    +avanzarEstado() void
    +pagar() ResultadoPago
    +cambiarMetodoPago(metodoPago MetodoPago) void
    +suscribir(canal CanalNotificacion) void
    +desuscribir(canal CanalNotificacion) void
    +notificar() void
}
class ItemPedido {
    -int cantidad
    -double precioUnitario
    +subtotal() double
}
class TransicionEstado {
    -LocalDateTime fecha
    -String estado
}
class DireccionEnvio {
    -String calle
    -String numero
    -String ciudad
    -String provincia
    -String codigoPostal
}
class EstadoPedido {
    <<interface>>
    +avanzar(pedido Pedido) void
    +puedeAvanzar() boolean
    +nombre() String
}
class EstadoPendiente {
    +avanzar(pedido Pedido) void
    +puedeAvanzar() boolean
    +nombre() String
}
class EstadoPagado {
    +avanzar(pedido Pedido) void
    +puedeAvanzar() boolean
    +nombre() String
}
class EstadoEnviado {
    +avanzar(pedido Pedido) void
    +puedeAvanzar() boolean
    +nombre() String
}
class EstadoEntregado {
    +avanzar(pedido Pedido) void
    +puedeAvanzar() boolean
    +nombre() String
}
EstadoPedido <|.. EstadoPendiente
EstadoPedido <|.. EstadoPagado
EstadoPedido <|.. EstadoEnviado
EstadoPedido <|.. EstadoEntregado
Cliente "1" --> "0..*" Pedido : realiza
Pedido "1" *-- "1..*" ItemPedido
Pedido "1" *-- "0..*" TransicionEstado : historial
Pedido "1" --> "0..1" DireccionEnvio : envío
Pedido "1" --> "1" EstadoPedido : estado actual
ItemPedido --> Variante

%% ===================== PAGO (Strategy) =====================
%% ===================== PASARELAS DE PAGO (Adapter) =====================
namespace Pagos {
    class MetodoPago {
        <<interface>>
        +procesarPago(monto double) ResultadoPago
        +validarDatosPago() boolean
    }
    class PagoTarjeta {
        -String numeroTarjeta
        -String titular
        -String vencimiento
        -String cvv
        -AdapterTarjeta adapter
        +procesarPago(monto double) ResultadoPago
        +validarDatosPago() boolean
    }
    class PagoPayPal {
        -String emailCuenta
        -AdapterPayPal adapter
        +procesarPago(monto double) ResultadoPago
        +validarDatosPago() boolean
    }
    class PagoTransferencia {
        -String cbu
        -String alias
        -String banco
        -AdapterTransferencia adapter
        +procesarPago(monto double) ResultadoPago
        +validarDatosPago() boolean
    }
    class ResultadoPago {
        -boolean exito
        -String mensaje
    }
    class AdapterPagoExterno {
        <<interface>>
        +procesar(monto double) ResultadoPago
    }
    class AdapterTarjeta {
        -PasarelaTarjetaExterna pasarela
        +procesar(monto double) ResultadoPago
    }
    class AdapterPayPal {
        -ServicioPayPalExterno servicio
        +procesar(monto double) ResultadoPago
    }
    class AdapterTransferencia {
        -ServicioBancoExterno servicio
        +procesar(monto double) ResultadoPago
    }
    class PasarelaTarjetaExterna {
        +autorizarImporte(importe double) RespuestaTarjeta
    }
    class ServicioPayPalExterno {
        +enviarPago(email String, total double) RespuestaPayPal
    }
    class ServicioBancoExterno {
        +registrarTransferencia(cbu String, importe double) RespuestaBanco
    }
}
MetodoPago <|.. PagoTarjeta
MetodoPago <|.. PagoPayPal
MetodoPago <|.. PagoTransferencia
MetodoPago ..> ResultadoPago
Pedido "1" --> "0..1" MetodoPago : estrategia (delega pago)
AdapterPagoExterno <|.. AdapterTarjeta
AdapterPagoExterno <|.. AdapterPayPal
AdapterPagoExterno <|.. AdapterTransferencia
PagoTarjeta --> AdapterTarjeta : usa
PagoPayPal --> AdapterPayPal : usa
PagoTransferencia --> AdapterTransferencia : usa
AdapterTarjeta --> PasarelaTarjetaExterna : adapta
AdapterPayPal --> ServicioPayPalExterno : adapta
AdapterTransferencia --> ServicioBancoExterno : adapta
AdapterPagoExterno ..> ResultadoPago

%% ===================== NOTIFICACIONES (Observer) =====================
namespace Notificaciones {
    class SujetoObservable {
        <<interface>>
        +suscribir(canal CanalNotificacion) void
        +desuscribir(canal CanalNotificacion) void
        +notificar() void
    }
    class CanalNotificacion {
        <<interface>>
        +actualizar(pedido Pedido) void
    }
    class CanalEmail {
        +actualizar(pedido Pedido) void
    }
    class CanalSMS {
        +actualizar(pedido Pedido) void
    }
    class CanalPush {
        +actualizar(pedido Pedido) void
    }
    class PreferenciasNotificacion {
        -boolean email
        -boolean sms
        -boolean push
    }
}
SujetoObservable <|.. Pedido
CanalNotificacion <|.. CanalEmail
CanalNotificacion <|.. CanalSMS
CanalNotificacion <|.. CanalPush
SujetoObservable "1" --> "0..*" CanalNotificacion : notifica a
Cliente "1" --> "1" PreferenciasNotificacion

%% ===================== FACADE =====================
class TiendaFacade {
    +confirmarCompra(carrito Carrito, metodoPago MetodoPago, cliente Cliente) ResultadoPago
}

TiendaFacade ..> Carrito : usa
TiendaFacade ..> Pedido : usa
TiendaFacade ..> MetodoPago : usa
TiendaFacade ..> CanalNotificacion : usa
TiendaFacade ..> Cliente : usa

%% ===================== CONFIGURACION (Singleton) =====================
class Configuracion {
    -Configuracion instancia$
    -String moneda
    -double tasaIva
    -double costoEnvio
    -double umbralEnvioGratis
    -Map~String, String~ configData
    -Configuracion()
    +obtenerInstancia()$ Configuracion
    +obtenerParametro(clave String) String
    +actualizarParametro(clave String, valor String) void
}

Configuracion ..> Configuracion : contiene

%% ===================== NOTAS DE PATRONES =====================
note for ComponenteCatalogo "Patrón Composite"
note for Categoria "Patrón Composite — Compuesto (contiene hijos y delega obtenerProductos en ellos)"
note for Producto "Patrón Composite — Hoja {leaf}"
note for EstadoPedido "Patrón State — cada estado controla si puede avanzar y define la transición"
note for EstadoEntregado "Estado final: puedeAvanzar() devuelve false"
note for MetodoPago "Patrón Strategy — Pedido delega el algoritmo de pago al método seleccionado en runtime"
note for AdapterPagoExterno "Patrón Adapter — normaliza APIs externas de pago a ResultadoPago"
note for SujetoObservable "Patrón Observer — Observable (Sujeto) con notificar() por convención"
note for CanalNotificacion "Patrón Observer — Observador. notificar() recorre observadores y llama actualizar(pedido)"
note for TiendaFacade "Patrón Facade"
note for Configuracion "Patrón Singleton"

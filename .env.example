# ─── MongoDB ───────────────────────────────────────────────
MONGO_USER=riva
MONGO_PASSWORD=rivapass
MONGO_DB=rivadb

# ─── Backend ────────────────────────────────────────────────
# Clave secreta para firmar los JWT. Cambiar por un valor seguro en cualquier entorno real.
JWT_SECRET=changeme_in_production

# ─── Frontend ───────────────────────────────────────────────
# URL base del backend consumida por React.
# En Docker Compose se sobreescribe internamente; este valor aplica a desarrollo local.
API_URL=http://localhost:8080
